# ==========================================
# RescueRank - Environment Configuration
# ==========================================

# ----------------- Database -----------------
POSTGRES_USER=rescuerank
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_DB=rescuerank_db
POSTGRES_PORT=5433
DATABASE_URL=postgresql+asyncpg://rescuerank:replace-with-a-local-password@localhost:5433/rescuerank_db

# ----------------- Core App -----------------
APP_NAME=RescueRank
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=replace-with-a-random-local-value-of-at-least-32-characters
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
DEMO_CITY="Karachi, Pakistan"
ENABLE_SIMULATOR=true

# ----------------- LLM Provider -----------------
# Supported: openrouter | mistral | groq | openai
LLM_PROVIDER=openrouter
LLM_MODEL=liquid/lfm-2.5-2.6b:free
OPENROUTER_API_KEY=
OPENROUTER_MODEL=liquid/lfm-2.5-2.6b:free
MISTRAL_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=

# ----------------- Notifications -----------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=
NOTIFY_WHATSAPP_PROVIDER=meta
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
ALERT_WHATSAPP_NUMBERS=

# ----------------- Alert Thresholds & Scheduler --
ALERT_RISK_THRESHOLD=0.70
ALERT_ETA_HOURS=6.0
ALERT_COOLDOWN_MIN=30
SCHEDULER_INTERVAL_MIN=15

# ----------------- External Services ------------
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
OPEN_METEO_FLOOD_URL=https://flood-api.open-meteo.com/v1
USE_FALLBACK_DATA=false
USE_OSRM=false
OSRM_ENDPOINT=http://router.project-osrm.org

# ----------------- Frontend ---------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_MAP_DEFAULT_LAT=24.8607
NEXT_PUBLIC_MAP_DEFAULT_LNG=67.0011
NEXT_PUBLIC_MAP_DEFAULT_ZOOM=12
