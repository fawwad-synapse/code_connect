DATABASE_URL=postgresql+asyncpg://rescuerank:rescuerank_secret@localhost:5432/rescuerank_db
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=rescuerank_super_secret_jwt_signing_key_32chars_min!
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000"]
DEMO_CITY="Karachi, Pakistan"
ENABLE_SIMULATOR=true

# LLM
LLM_PROVIDER=mistral
LLM_MODEL=mistral-small-latest
MISTRAL_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=

# Telegram / WhatsApp
TELEGRAM_BOT_TOKEN=
NOTIFY_WHATSAPP_PROVIDER=meta
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
ALERT_WHATSAPP_NUMBERS=

# Alerting
ALERT_RISK_THRESHOLD=0.70
ALERT_ETA_HOURS=6.0
ALERT_COOLDOWN_MIN=30
SCHEDULER_INTERVAL_MIN=15
